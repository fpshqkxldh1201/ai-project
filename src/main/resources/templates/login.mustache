<!DOCTYPE html>
<html lang="ko">
<head>
  <link rel="icon" href="data:,">
  <meta name="robots" content="noindex, nofollow">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lumi · 로그인</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');
  :root { --cyan: #3FE0FF; --cyan-glow: rgba(63,224,255,0.4); --amber: #FFA94D; --bg: #02060c; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background-color: var(--bg); color: var(--cyan); font-family: 'Rajdhani', sans-serif;
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    background-image:
      radial-gradient(circle at 50% 30%, rgba(63,224,255,0.08) 0%, transparent 60%),
      linear-gradient(rgba(63,224,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(63,224,255,0.035) 1px, transparent 1px);
    background-size: 100% 100%, 32px 32px, 32px 32px;
  }
  .auth-card {
    width: 340px; background: rgba(4,12,24,0.78); border: 1px solid rgba(63,224,255,0.28);
    padding: 34px 30px; backdrop-filter: blur(10px);
    box-shadow: inset 0 0 18px rgba(63,224,255,0.05), 0 0 24px rgba(0,0,0,0.6);
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 16px 100%, 0 calc(100% - 16px));
    position: relative;
  }
  .auth-card::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 100%; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
  .brand { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; }
  .brand-logo { width: 12px; height: 12px; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); transform: rotate(45deg); }
  .brand-title { font-family: 'Orbitron', sans-serif; font-weight: 900; font-size: 1.3rem; letter-spacing: 5px; text-shadow: 0 0 12px var(--cyan-glow); }
  h1 { font-size: 0.85rem; font-weight: 700; letter-spacing: 1px; color: #E4F7FF; margin-bottom: 20px; }
  label { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 1px; color: #4A6472; margin-bottom: 6px; }
  input {
    width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(63,224,255,0.25); color: var(--cyan);
    font-family: 'Rajdhani', sans-serif; font-size: 0.9rem; font-weight: 600; padding: 10px 12px; margin-bottom: 16px;
  }
  input:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 8px rgba(63,224,255,0.3); }
  button, .btn {
    width: 100%; padding: 11px; font-family: 'Rajdhani', sans-serif; font-weight: 700; letter-spacing: 1px;
    cursor: pointer; border: none; font-size: 0.85rem; display: block; text-align: center; text-decoration: none;
  }
  .btn-primary { background: var(--cyan); color: #02060c; box-shadow: 0 0 12px var(--cyan-glow); margin-bottom: 14px; }
  .btn-primary:hover { opacity: 0.9; }
  .divider { display: flex; align-items: center; gap: 10px; margin: 16px 0; font-size: 0.62rem; color: #3B4F5A; letter-spacing: 1px; }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: rgba(63,224,255,0.2); }
  .btn-google { background: transparent; border: 1px solid rgba(255,169,77,0.4); color: var(--amber); }
  .btn-google:hover { background: rgba(255,169,77,0.08); }
  .msg { font-size: 0.74rem; padding: 9px 10px; margin-bottom: 16px; border-left: 2px solid var(--amber); color: var(--amber); background: rgba(255,169,77,0.08); display: none; }
  .msg.show { display: block; }
  .msg.ok { border-left-color: var(--cyan); color: var(--cyan); background: rgba(63,224,255,0.08); }
  .footer-link { text-align: center; margin-top: 18px; font-size: 0.74rem; color: #4A6472; }
  .footer-link a { color: var(--cyan); text-decoration: none; }
</style>
</head>
<body>
  <div class="auth-card">
    <div class="brand"><div class="brand-logo"></div><div class="brand-title">LUMI</div></div>
    <h1>계정으로 로그인</h1>

    <div class="msg" id="msgBox"></div>

    <form method="post" action="/login">
      <input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">
      <label for="username">아이디</label>
      <input type="text" id="username" name="username" autocomplete="username" required autofocus>
      <label for="password">비밀번호</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="btn-primary">로그인</button>
    </form>

    <div class="divider">또는</div>
    <a class="btn btn-google" href="/oauth2/authorization/google">Google로 로그인</a>

    <div class="footer-link">계정이 없으신가요? <a href="/register">회원가입</a></div>
  </div>

  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var box = document.getElementById('msgBox');
      if (params.has('error')) {
        box.textContent = '아이디 또는 비밀번호가 올바르지 않습니다.';
        box.classList.add('show');
      } else if (params.has('expired') || params.has('idle')) {
        box.textContent = params.has('idle')
          ? '오래 사용하지 않아 자동으로 로그아웃되었습니다.'
          : '세션이 만료되어 로그아웃되었습니다. 다시 로그인해주세요.';
        box.classList.add('show');
      } else if (params.has('logout')) {
        box.textContent = '로그아웃되었습니다.';
        box.classList.add('show', 'ok');
      } else if (params.has('registered')) {
        box.textContent = '가입이 완료되었습니다. 로그인해주세요.';
        box.classList.add('show', 'ok');
      }
    })();
  </script>
</body>
</html>
