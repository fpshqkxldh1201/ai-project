# 이 파일을 .env 로 복사해서 값을 채운다 (cp .env.example .env). .env 는 절대 git 에 올리지 않는다.
# 아래는 모두 자리표시자다. 실제 값은 서버의 .env 에만 둔다.

# HTTPS 주소(도메인). 예: lumi-abc.duckdns.org  또는  1-2-3-4.sslip.io
SITE_ADDRESS=CHANGE_ME_DOMAIN

# DB 비밀번호 (길고 무작위로, 서로 다르게)
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# 로그인 토큰 서명 비밀값: openssl rand -base64 48 로 만든 값
JWT_SECRET=CHANGE_ME

# Google 로그인 (Google Cloud 콘솔의 OAuth 클라이언트). 리디렉션 URI: https://<도메인>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 AI/검색 키 (옛 키가 노출된 적 있다면 반드시 재발급한 새 키를 넣는다)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
FISH_API_KEY=

# (선택) 사진 표정 모델. 비워 두면 꺼짐
EMOTION_IMAGE_MODEL=
